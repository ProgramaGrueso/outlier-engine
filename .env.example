# Copiar a .env y completar. Nunca commitear .env.

# --- Obligatoria ---
YOUTUBE_API_KEY=

# --- Opcional: solo necesaria para el tier premium (juez de la Fase 3) ---
ANTHROPIC_API_KEY=

# --- LLM cheap (Ollama local) ---
OLLAMA_HOST=http://localhost:11434
# Modelo por defecto para cualquier rol sin override
OLLAMA_MODEL=qwen2.5:7b
# Overrides por rol (vacío = usa OLLAMA_MODEL)
# Fase 2: análisis de formato (JSON)
OLLAMA_MODEL_CLASSIFY=
# Fase 3: guionista
OLLAMA_MODEL_WRITE=
# Fase 3: crítico
OLLAMA_MODEL_CRITIC=
# Fase 4: guion -> prompts REF2VA
OLLAMA_MODEL_SCENES=

# --- LLM premium (Anthropic) ---
ANTHROPIC_MODEL=claude-sonnet-5

# --- Datos y pipeline ---
DB_PATH=data/outliers.db
YT_DAILY_QUOTA=10000

# --- Fase 1: research ---
OUTLIER_RATIO_MIN=5
# Vistas mínimas para mostrar/analizar un outlier (se guardan todos igual)
OUTLIER_MIN_VIEWS=10000
# No volver a consultar un canal durante N días
CHANNEL_CACHE_DAYS=7
# Últimos N uploads del canal para calcular la mediana
CHANNEL_SAMPLE_SIZE=30
# Canales con menos videos se descartan (mediana poco fiable)
CHANNEL_MIN_VIDEOS=5
# Duración máxima para considerar un video como Short
SHORT_MAX_SECONDS=180
# Idiomas aceptados, ISO de 2 letras separados por coma (vacío = todos)
RESULT_LANGUAGES=es
# Categorías de YouTube excluidas, separadas por coma (25 = News & Politics)
EXCLUDE_CATEGORY_IDS=25
# Máximo de videos por canal en `engine top`
TOP_MAX_PER_CHANNEL=2
