# Copiar a .env y completar. Nunca commitear .env.

# --- Obligatorias ---
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=

# --- LLM cheap (Ollama local) ---
OLLAMA_HOST=http://localhost:11434
# Modelo por defecto para cualquier rol sin override
OLLAMA_MODEL=qwen2.5:7b
# Overrides por rol (vacío = usa OLLAMA_MODEL)
# Fase 2: análisis de formato (JSON)
OLLAMA_MODEL_CLASSIFY=
# Fase 3: guionista
OLLAMA_MODEL_WRITE=
# Fase 3: crítico
OLLAMA_MODEL_CRITIC=
# Fase 4: guion -> prompts REF2VA
OLLAMA_MODEL_SCENES=

# --- LLM premium (Anthropic) ---
ANTHROPIC_MODEL=claude-sonnet-5

# --- Datos y pipeline ---
DB_PATH=data/outliers.db
OUTLIER_RATIO_MIN=5
YT_DAILY_QUOTA=10000
